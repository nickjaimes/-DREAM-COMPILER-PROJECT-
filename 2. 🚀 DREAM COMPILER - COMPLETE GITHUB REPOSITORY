# src/neural_interface/muse_integration.py
"""
Muse EEG Headset Integration
"""

import asyncio
import numpy as np
from datetime import datetime
from typing import List, Dict, Optional
import bluetooth
import struct

class MuseHeadset:
    """Muse EEG headset integration"""
    
    SUPPORTED_MODELS = {
        "muse_2": {
            "channels": 5,
            "sampling_rate": 256,
            "battery_life": 10,
            "features": ["eeg", "ppg", "gyro", "accel"]
        },
        "muse_s": {
            "channels": 7,
            "sampling_rate": 500,
            "battery_life": 5,
            "features": ["eeg", "ppg", "gyro", "accel", "temperature"]
        }
    }
    
    def __init__(self, model: str = "muse_2"):
        self.model = model
        self.specs = self.SUPPORTED_MODELS.get(model, self.SUPPORTED_MODELS["muse_2"])
        self.connected = False
        self.streaming = False
        self.data_buffer = []
        self.dream_events = []
        
    async def connect(self):
        """Connect to Muse headset"""
        print("📡 Connecting to Muse headset...")
        
        try:
            # Discover Muse devices
            devices = await self._discover_devices()
            
            if not devices:
                raise ConnectionError("No Muse devices found")
            
            # Connect to first available device
            device = devices[0]
            self.connection = await self._establish_connection(device)
            
            # Configure device
            await self._configure_device()
            
            self.connected = True
            print(f"✅ Connected to {device['name']}")
            
        except Exception as e:
            print(f"❌ Connection failed: {e}")
            raise
    
    async def start_streaming(self):
        """Start EEG data streaming"""
        if not self.connected:
            raise ConnectionError("Not connected to device")
        
        print("📊 Starting EEG stream...")
        
        # Start data collection
        self.streaming = True
        self.data_buffer = []
        
        # Start background processing
        asyncio.create_task(self._process_stream())
        
        print("✅ EEG stream started")
    
    async def record_dreams(self, duration_hours: float = 8):
        """Record dreams for specified duration"""
        print(f"💤 Recording dreams for {duration_hours} hours...")
        
        # Start streaming
        await self.start_streaming()
        
        # Record for specified duration
        await asyncio.sleep(duration_hours * 3600)
        
        # Stop streaming
        await self.stop_streaming()
        
        # Process recorded data
        dreams = self._extract_dream_events()
        
        return dreams
    
    async def _process_stream(self):
        """Process EEG data stream in real-time"""
        while self.streaming:
            try:
                # Read data from device
                raw_data = await self._read_device_data()
                
                # Process EEG signals
                processed = self._process_eeg_data(raw_data)
                
                # Detect dream events
                dream_event = self._detect_dream_event(processed)
                
                if dream_event:
                    self.dream_events.append(dream_event)
                    print(f"💭 Dream event detected: {dream_event['type']}")
                
                # Buffer data
                self.data_buffer.append(processed)
                
                # Limit buffer size
                if len(self.data_buffer) > 1000:
                    self.data_buffer = self.data_buffer[-1000:]
                
                await asyncio.sleep(0.1)  # 100ms processing interval
                
            except Exception as e:
                print(f"⚠️ Stream processing error: {e}")
                await asyncio.sleep(1)
    
    def _detect_dream_event(self, eeg_data: Dict) -> Optional[Dict]:
        """Detect dream events from EEG data"""
        
        # Calculate features
        features = {
            "alpha_power": self._calculate_band_power(eeg_data, "alpha"),
            "theta_power": self._calculate_band_power(eeg_data, "theta"),
            "beta_power": self._calculate_band_power(eeg_data, "beta"),
            "rem_likelihood": self._calculate_rem_likelihood(eeg_data),
            "eye_movement": self._detect_eye_movements(eeg_data)
        }
        
        # Check for REM sleep (dream state)
        if features["rem_likelihood"] > 0.7:
            return {
                "timestamp": datetime.now().isoformat(),
                "type": "rem_dream",
                "intensity": features["rem_likelihood"],
                "features": features,
                "raw_data": eeg_data
            }
        
