```python
# src/dream_analyzer/symbol_interpreter.py
"""
Dream Symbol Interpretation System
"""

import json
import numpy as np
from typing import Dict, List, Any
from dataclasses import dataclass
from enum import Enum

class DreamSymbolType(Enum):
    """Types of dream symbols"""
    OBJECT = "object"
    ACTION = "action"
    PERSON = "person"
    PLACE = "place"
    EMOTION = "emotion"
    ABSTRACT = "abstract"

@dataclass
class DreamSymbol:
    """A single dream symbol"""
    symbol: str
    symbol_type: DreamSymbolType
    context: str
    emotional_valence: float  # -1 to 1
    intensity: float  # 0 to 1
    programming_mapping: Dict[str, Any] = None

class SymbolInterpreter:
    """Interprets dream symbols into programming concepts"""
    
    def __init__(self, symbol_database_path: str = "data/dream_symbols.json"):
        self.symbol_database = self._load_symbol_database(symbol_database_path)
        self.programming_mappings = self._load_programming_mappings()
        
    def interpret_symbols(self, dream_data: Dict) -> List[DreamSymbol]:
        """Interpret raw dream data into symbols"""
        print(f"🔍 Interpreting dream symbols...")
        
        symbols = []
        
        # Extract symbols from EEG patterns
        eeg_symbols = self._extract_eeg_symbols(dream_data)
        symbols.extend(eeg_symbols)
        
        # Extract symbols from emotional data
        emotion_symbols = self._extract_emotion_symbols(dream_data)
        symbols.extend(emotion_symbols)
        
        # Extract symbols from narrative context (if available)
        if "narrative" in dream_data:
            narrative_symbols = self._extract_narrative_symbols(dream_data["narrative"])
            symbols.extend(narrative_symbols)
        
        # Map symbols to programming concepts
        mapped_symbols = self._map_to_programming(symbols)
        
        print(f"✅ Interpreted {len(mapped_symbols)} symbols")
        return mapped_symbols
    
    def _extract_eeg_symbols(self, dream_data: Dict) -> List[DreamSymbol]:
        """Extract symbols from EEG patterns"""
        symbols = []
        
        # Analyze frequency patterns
        if "eeg_features" in dream_data:
            features = dream_data["eeg_features"]
            
            # High theta power - problem solving
            if features.get("theta_power", 0) > 0.7:
                symbols.append(DreamSymbol(
                    symbol="puzzle",
                    symbol_type=DreamSymbolType.OBJECT,
                    context="problem_solving",
                    emotional_valence=0.3,
                    intensity=features["theta_power"]
                ))
            
            # High gamma - insight
            if features.get("gamma_power", 0) > 0.6:
                symbols.append(DreamSymbol(
                    symbol="lightbulb",
                    symbol_type=DreamSymbolType.OBJECT,
                    context="insight",
                    emotional_valence=0.8,
                    intensity=features["gamma_power"]
                ))
            
            # Alpha asymmetry - emotional processing
            if features.get("alpha_asymmetry", 0) > 0.5:
                symbols.append(DreamSymbol(
                    symbol="heart",
                    symbol_type=DreamSymbolType.EMOTION,
                    context="emotional_processing",
                    emotional_valence=0.5,
                    intensity=features["alpha_asymmetry"]
                ))
        
        return symbols
    
    def _extract_emotion_symbols(self, dream_data: Dict) -> List[DreamSymbol]:
        """Extract symbols from emotional data"""
        symbols = []
        
        if "emotional_features" in dream_data:
            emotions = dream_data["emotional_features"]
            
            # Fear/Anxiety
            if emotions.get("fear", 0) > 0.6:
                symbols.append(DreamSymbol(
                    symbol="chase",
                    symbol_type=DreamSymbolType.ACTION,
                    context="threat_response",
                    emotional_valence=-0.8,
                    intensity=emotions["fear"]
                ))
            
            # Joy/Excitement
            if emotions.get("joy", 0) > 0.6:
                symbols.append(DreamSymbol(
                    symbol="celebration",
                    symbol_type=DreamSymbolType.ACTION,
                    context="achievement",
                    emotional_valence=0.9,
                    intensity=emotions["joy"]
                ))
            
            # Curiosity
            if emotions.get("curiosity", 0) > 0.5:
                symbols.append(DreamSymbol(
                    symbol="exploration",
                    symbol_type=DreamSymbolType.ACTION,
                    context="discovery",
                    emotional_valence=0.7,
                    intensity=emotions["curiosity"]
                ))
        
        return symbols
    
    def _extract_narrative_symbols(self, narrative: str) -> List[DreamSymbol]:
        """Extract symbols from narrative text"""
        symbols = []
        
        # Common dream themes and their mappings
        theme_patterns = {
            "flying": {"symbol": "flight", "type": DreamSymbolType.ACTION, "valence": 0.8},
            "falling": {"symbol": "fall", "type": DreamSymbolType.ACTION, "valence": -0.9},
            "water": {"symbol": "water", "type": DreamSymbolType.OBJECT, "valence": 0.3},
            "building": {"symbol": "construction", "type": DreamSymbolType.ACTION, "valence": 0.4},
            "machine": {"symbol": "machine", "type": DreamSymbolType.OBJECT, "valence": 0.2},
            "school": {"symbol": "learning", "type": DreamSymbolType.PLACE, "valence": 0.1},
        }
        
        narrative_lower = narrative.lower()
        
        for theme, mapping in theme_patterns.items():
            if theme in narrative_lower:
                symbols.append(DreamSymbol(
                    symbol=mapping["symbol"],
                    symbol_type=mapping["type"],
                    context=theme,
                    emotional_valence=mapping["valence"],
                    intensity=0.7
                ))
        
        return symbols
    
    def _map_to_programming(self, symbols: List[DreamSymbol]) -> List[DreamSymbol]:
        """Map dream symbols to programming concepts"""
        
        programming_map = {
            "puzzle": {
                "concept": "algorithm_design",
                "patterns": ["divide_and_conquer", "dynamic_programming", "backtracking"],
                "data_structures": ["graph", "tree", "matrix"],
                "optimization": "time_complexity"
            },
            "lightbulb": {
                "concept": "insight_optimization",
                "patterns": ["elegant_solution", "novel_approach", "simplification"],
                "optimization": "space_complexity",
                "quality": "readability"
            },
            "flight": {
                "concept": "asynchronous_programming",
                "patterns": ["async_await", "promises", "coroutines"],
                "optimization": "concurrency",
                "data_structures": ["queue", "channel", "future"]
            },
            "water": {
                "concept": "data_flow",
                "patterns": ["stream_processing", "data_pipelines", "reactive_programming"],
                "optimization": "throughput",
                "data_structures": ["stream", "buffer", "pipe"]
            },
            "construction": {
                "concept": "system_architecture",
                "patterns": ["microservices", "layered_architecture", "plugin_system"],
                "optimization": "scalability",
                "quality": "maintainability"
            },
            "chase": {
                "concept": "cybersecurity",
                "patterns": ["authentication", "encryption", "intrusion_detection"],
                "optimization": "security",
                "data_structures": ["hash_table", "bloom_filter", "merkle_tree"]
            },
            "exploration": {
                "concept": "algorithm_exploration",
                "patterns": ["search_algorithms", "optimization_algorithms", "heuristics"],
                "optimization": "completeness",
                "data_structures": ["priority_queue", "stack", "set"]
            }
        }
        
        for symbol in symbols:
            if symbol.symbol in programming_map:
                symbol.programming_mapping = programming_map[symbol.symbol]
        
        return symbols
    
    def calculate_creativity_score(self, symbols: List[DreamSymbol]) -> float:
        """Calculate creativity score from symbols"""
        if not symbols:
            return 0.0
        
        scores = []
        
        for symbol in symbols:
            # Symbol novelty (rarity in database)
            novelty = self._calculate_novelty(symbol.symbol)
            
            # Symbol complexity (multiple interpretations)
            complexity = self._calculate_complexity(symbol)
            
            # Emotional intensity
            emotional_impact = abs(symbol.emotional_valence) * symbol.intensity
            
            # Symbol diversity
            symbol_types = set(s.symbol_type.value for s in symbols)
            diversity = len(symbol_types) / len(DreamSymbolType)
            
            # Combined creativity score
            symbol_score = (novelty * 0.3 + 
                          complexity * 0.3 + 
                          emotional_impact * 0.2 + 
                          diversity * 0.2)
            
            scores.append(symbol_score)
        
        return np.mean(scores) if scores else 0.0
    
    def _calculate_novelty(self, symbol: str) -> float:
        """Calculate novelty of a symbol"""
        # In practice, would use frequency in dream database
        # For now, return random but consistent value
        return hash(symbol) % 100 / 100
    
    def _calculate_complexity(self, symbol: DreamSymbol) -> float:
        """Calculate complexity of a symbol"""
        complexity_factors = {
            DreamSymbolType.ABSTRACT: 0.9,
            DreamSymbolType.EMOTION: 0.7,
            DreamSymbolType.ACTION: 0.6,
            DreamSymbolType.OBJECT: 0.4,
            DreamSymbolType.PERSON: 0.5,
            DreamSymbolType.PLACE: 0.3
        }
        
        base_complexity = complexity_factors.get(symbol.symbol_type, 0.5)
        
        # Adjust based on programming mapping complexity
        if symbol.programming_mapping:
            mapping = symbol.programming_mapping
            patterns = len(mapping.get("patterns", []))
            data_structures = len(mapping.get("data_structures", []))
            
            mapping_complexity = (patterns * 0.1 + data_structures * 0.05)
            base_complexity = min(1.0, base_complexity + mapping_complexity)
        
        return base_complexity
    
    def _load_symbol_database(self, path: str) -> Dict:
        """Load dream symbol database"""
        try:
            with open(path, 'r') as f:
                return json.load(f)
        except FileNotFoundError:
            # Return minimal database
            return {
                "symbols": {},
                "mappings": {},
                "frequencies": {}
            }
    
