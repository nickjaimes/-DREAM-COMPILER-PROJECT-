# src/__init__.py
"""
Dream Compiler - Main Package
"""

__version__ = "1.0.0-alpha"
__author__ = "Safeway Guardian Research Team"
__email__ = "research@safewayguardian.ai"

from .neural_interface import NeuralInterface, DreamEvent
from .dream_analyzer import DreamAnalyzer, CreativityScore
from .code_synthesizer import CodeSynthesizer, LanguageGenerator
from .security_mind import SecurityMind, EthicalGuardrails
from .quantum_dreamlab import QuantumDreamLab
from .sleep_science import SleepOptimizer
from .reality_bridge import RealityBridge

class DreamSession:
    """Main interface for Dream Compiler sessions"""
    
    def __init__(self, config_path=None):
        self.config = self._load_config(config_path)
        self.neural = NeuralInterface(self.config)
        self.analyzer = DreamAnalyzer(self.config)
        self.synthesizer = CodeSynthesizer(self.config)
        self.security = SecurityMind(self.config)
        self.quantum = QuantumDreamLab(self.config)
        self.sleep = SleepOptimizer(self.config)
        self.bridge = RealityBridge(self.config)
        
        self.dreams = []
        self.code_results = []
        self.security_reports = []
        
    def start_session(self, challenge: str, language: str = "python"):
        """Start a new dream compilation session"""
        self.challenge = challenge
        self.language = language
        
        print(f"🌙 Starting Dream Compiler Session")
        print(f"   Challenge: {challenge}")
        print(f"   Language: {language}")
        
        # Connect to neural interface
        self.neural.connect()
        
        # Set up sleep optimization
        self.sleep.optimize_environment()
        
        return self
    
    def record_dreams(self, duration_hours: float = 8):
        """Record dreams for specified duration"""
        print(f"💤 Recording dreams for {duration_hours} hours...")
        
        self.dreams = self.neural.record_dreams(
            duration_hours=duration_hours,
            challenge=self.challenge
        )
        
        print(f"✅ Recorded {len(self.dreams)} dream events")
        return self.dreams
    
    def analyze_dreams(self):
        """Analyze recorded dreams"""
        print("🔍 Analyzing dreams...")
        
        analysis = self.analyzer.analyze(
            dreams=self.dreams,
            challenge=self.challenge
        )
        
        # Apply quantum enhancement
        if self.config.get("quantum_enabled", False):
            analysis = self.quantum.enhance_analysis(analysis)
        
        # Security check
        security_report = self.security.analyze_dreams(
            dreams=self.dreams,
            analysis=analysis
        )
        
        self.analysis = analysis
        self.security_reports.append(security_report)
        
        return analysis
    
    def compile_code(self):
        """Compile dreams to code"""
        print("⚙️ Compiling dreams to code...")
        
        code = self.synthesizer.generate(
            analysis=self.analysis,
            language=self.language,
            challenge=self.challenge
        )
        
        # Optimize with quantum principles
        if self.config.get("quantum_optimization", False):
            code = self.quantum.optimize_code(code)
        
        # Security validation
        code = self.security.validate_code(
            code=code,
            security_report=self.security_reports[-1]
        )
        
        self.code_results.append(code)
        
        return code
    
    def deliver_results(self):
        """Deliver morning results"""
        print("☀️ Delivering morning results...")
        
        results = self.bridge.deliver(
            dreams=self.dreams,
            analysis=self.analysis,
            code=self.code_results[-1],
            security_reports=self.security_reports
        )
        
        return results
    
    def complete_session(self):
        """Complete the session with all results"""
        print("✨ Completing dream compilation session...")
        
        results = {
            "challenge": self.challenge,
            "dreams": self.dreams,
            "analysis": self.analysis,
            "code": self.code_results[-1] if self.code_results else None,
            "security_reports": self.security_reports,
            "creativity_score": self.analysis.creativity_score,
            "timestamp": datetime.now().isoformat()
        }
        
        # Save session
        self._save_session(results)
        
        print(f"✅ Session completed!")
        print(f"   Creativity Score: {results['creativity_score']}/10")
        print(f"   Code Generated: {len(results['code']) if results['code'] else 0} lines")
        
        return results
    
    def _load_config(self, config_path):
        """Load configuration"""
        default_config = {
            "neural_device": "muse",
            "quantum_enabled": False,
            "quantum_optimization": False,
            "security_level": "high",
            "privacy_mode": "strict",
            "output_formats": ["code", "documentation", "tests"],
            "auto_deploy": False
        }
        
        if config_path and os.path.exists(config_path):
            with open(config_path, 'r') as f:
                user_config = yaml.safe_load(f)
                default_config.update(user_config)
        
        return default_config
    
    def _save_session(self, results):
        """Save session results"""
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"dream_session_{timestamp}.json"
        
        with open(filename, 'w') as f:
            json.dump(results, f, indent=2, default=str)
        
        print(f"📁 Session saved to {filename}")
