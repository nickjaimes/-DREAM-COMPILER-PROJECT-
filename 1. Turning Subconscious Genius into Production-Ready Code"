    def _detect_nightmares(self, dreams: List[DreamEvent]) -> List[str]:
        """Detect potential nightmares in dreams"""
        nightmare_indicators = []
        
        for dream in dreams:
            if dream.emotional_intensity > 0.8:
                nightmare_indicators.append(f"High emotional intensity: {dream.symbol}")
            if dream.clarity < 0.3:
                nightmare_indicators.append(f"Low clarity: {dream.symbol}")
        
        return nightmare_indicators
    
    def _generate_security_notes(self, security_pattern: str, nightmares: List[str]) -> List[str]:
        """Generate security recommendations based on nightmares"""
