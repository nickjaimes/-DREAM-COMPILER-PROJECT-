    # Helper analysis methods
    def _find_primary_symbol(self, dreams: List[DreamEvent]) -> str:
        if not dreams:
            return "no_dreams"
        # Find most intense or most clear dream
        return max(dreams, key=lambda d: d.emotional_intensity * d.clarity).symbol
    
    def _calculate_emotional_arc(self, dreams: List[DreamEvent]) -> Dict:
        intensities = [d.emotional_intensity for d in dreams]
        return {
            "average_intensity": np.mean(intensities),
            "intensity_range": (min(intensities), max(intensities)),
            "positive_growth": intensities[-1] > intensities[0] if len(intensities) > 1 else False
        }
    
    def _detect_solution_pattern(self, dreams: List[DreamEvent]) -> str:
        symbols = [d.symbol for d in dreams]
        if len(set(symbols)) == 1:
            return "focused_solution"
        return "exploratory_solution"
    
    def _calculate_creativity_score(self, dreams: List[DreamEvent]) -> float:
        # Higher score for more diverse symbols and high clarity
        symbols = [d.symbol for d in dreams]
        diversity = len(set(symbols)) / len(symbols) if symbols else 0
        avg_clarity = np.mean([d.clarity for d in dreams]) if dreams else 0
        return (diversity * 0.6) + (avg_clarity * 0.4)

