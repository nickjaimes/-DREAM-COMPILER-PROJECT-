    # Step 2: Analyze dreams
    analysis = compiler.analyze_dreams(dreams)
    
    print(f"\n📊 Analysis Results:")
    print(f"  Primary Symbol: {analysis['primary_symbol']}")
    print(f"  Programming Concept: {analysis.get('programming_concept', 'N/A')}")
    print(f"  Creativity Score: {analysis['creativity_score']:.2f}/1.0")
    
    if analysis['nightmare_flags']:
        print(f"  ⚠️ Nightmares detected: {len(analysis['nightmare_flags'])}")
    
    # Step 3: Compile to code
